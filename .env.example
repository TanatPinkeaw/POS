# PostgreSQL connection used by Prisma and the app at runtime.
DATABASE_URL="postgresql://pos_app:pos_app@localhost:5432/pos_dev?schema=public"

# Separate database for integration tests; the suite truncates its tables.
TEST_DATABASE_URL="postgresql://pos_app:pos_app@localhost:5432/pos_test?schema=public"

# 32+ byte secret used to sign session JWTs and pickup QR tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Custom server binding.
PORT=3000
HOSTNAME=localhost

# How long a Phase 1 pre-order may sit unconfirmed before it auto-expires.
PREORDER_CONFIRM_TIMEOUT_MINUTES=15

# How long a Phase 3 order is held before it can be flagged as a no-show.
PREORDER_HOLD_HOURS=4
