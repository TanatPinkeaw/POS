[TEMPLATE]
# PostgreSQL connection used by Prisma and the app at runtime.
DATABASE_URL="postgresql://pos_app:pos_app@localhost:5432/pos_dev?schema=public"

# Separate database for integration tests; the suite truncates its tables.
TEST_DATABASE_URL="postgresql://pos_app:pos_app@localhost:5432/pos_test?schema=public"

# 32+ byte secret used to sign session JWTs and pickup QR tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# This deployment's Google OAuth client id (ADR 0020). A customer's Google id token
# is accepted only when its audience is this value. Leave it unset and the Google
# door refuses every token — counter enrolment is unaffected.
GOOGLE_CLIENT_ID=""

# Override the JWKS a Google id token is verified against. Leave it unset to use
# Google's published keys at https://www.googleapis.com/oauth2/v3/certs; set it to
# mirror them behind an egress proxy. It moves the trust anchor — whoever sets it can
# mint tokens this deployment will believe — so only the operator sets it. The
# acceptance run points it at a key set it serves itself.
GOOGLE_JWKS_URL=""

# Custom server binding.
PORT=3000
HOSTNAME=localhost

# How long a Phase 1 pre-order may sit unconfirmed before it auto-expires.
PREORDER_CONFIRM_TIMEOUT_MINUTES=15

# How long a Phase 3 order is held before it can be flagged as a no-show.
PREORDER_HOLD_HOURS=4

# Shared secret a bank-notification bridge or payment provider posts in
# `x-payment-secret`. It opens two endpoints — confirming a transfer by hand at
# `/api/v1/payments/intents/{ref}/confirm`, and the bridge's own
# `/api/v1/payments/inbound` — because both can mark money as received, so they
# are one trust boundary rather than two. Leave it unset and a person confirms
# instead, with a supervisor PIN.
PAYMENT_WEBHOOK_SECRET=""

# How long a PromptPay QR stays payable before the till withdraws it.
PAYMENT_INTENT_TTL_SECONDS=300

# How long a customer may still download a receipt image, in days (ADR 0021).
# This is an access rule, not a retention rule: the order is kept regardless.
RECEIPT_ACCESS_DAYS=30

# How long one issued receipt link lives, in minutes; it never outlives the window.
RECEIPT_LINK_TTL_MINUTES=60

# How long a customer-display pairing code stays redeemable.
DISPLAY_PAIRING_TTL_MINUTES=5

# --- Proving a customer's phone (optional, ADR 0020 §5)
# The sign-in OTP door is unauthenticated and costs money per message, so it is
# rate-limited per number and per address. The provider is chosen here, the same way
# NOTIFY_CHANNEL chooses one: point the URL at an SMS gateway or your own script.
#   webhook  A JSON POST `{ to, code, text, kind }`; the optional secret rides as
#            `x-otp-secret` so the gateway can refuse strangers.
# Leave OTP_CHANNEL unset and the door answers 503 rather than texting anybody.
OTP_CHANNEL=""
OTP_WEBHOOK_URL=""
OTP_WEBHOOK_SECRET=""
# How long a code stays valid, in minutes.
OTP_TTL_MINUTES=5

# --- Reading the shop's own bank notifications (optional, `npm run bank:bridge`)
# The bridge logs into a mailbox the bank sends notifications to and posts what it
# finds to this app, so an incoming transfer closes its own bill. No payment
# provider and no per-check fee; the trade is a script the shop has to keep
# running. Check it against a saved notification before wiring it up:
#   npm run bank:bridge -- --file ./notification.eml
BANK_IMAP_HOST=""
BANK_IMAP_PORT=993
BANK_IMAP_USER=""
BANK_IMAP_PASSWORD=""
BANK_IMAP_MAILBOX="INBOX"

# Only mail from this sender counts as a notification (matched against the From
# header, case-insensitively). Set it if the shop reuses an ordinary mailbox;
# leave it empty for a mailbox created solely for bank notifications.
BANK_NOTIFICATION_FROM=""

# Where the app is served; the till is usually on the same machine.
BANK_BRIDGE_BASE_URL="http://localhost:3000"
# What the record calls this source, so several bridges can be told apart.
BANK_BRIDGE_SOURCE="bank-bridge"

# How to find the amount in *this* bank's wording. A Thai example; a capture group
# is used when there is one and the whole match otherwise. The reference the
# customer typed is deliberately not configured here — the server looks for it
# among the QRs it has open, which is what stops a bridge from having to know the
# till's state.
BANK_AMOUNT_REGEX='จำนวนเงิน\s*:?\s*([0-9][0-9,]*\.?[0-9]*)'

# --- Telling people things (optional, `npm run notify:worker`)
# Off by default, and off means no messages are queued at all: alerts stay in the
# app and on the customer display. Set a channel and the system also queues a note
# to the shop when a pre-order arrives, and the collection code to the customer
# when their parcel is packed.
#
#   line     LINE Messaging API push. Addresses a LINE user id or group id, so
#            NOTIFY_STAFF_TO must be one (a group id starts with C). A customer's
#            phone number is *not* a LINE address, so a collection code is never
#            pushed to LINE — the customer reads theirs in the app.
#   webhook  A JSON POST to your own gateway: an SMS provider, or a script.
#            Body is `{ to, text, kind }`, where `to` is a phone number for a
#            customer's message and NOTIFY_STAFF_TO for the shop's own.
NOTIFY_CHANNEL=""
# Where the shop's own messages go: a LINE group id, or a phone number.
NOTIFY_STAFF_TO=""
# webhook: the URL to POST to, and an optional secret sent as `x-notify-secret`
# so the gateway can refuse strangers. It is the *shop's* URL — nothing here
# calls a service of ours, because there is no service of ours.
NOTIFY_WEBHOOK_URL=""
NOTIFY_WEBHOOK_SECRET=""
# line: a channel access token from the LINE Developers console.
NOTIFY_LINE_TOKEN=""
