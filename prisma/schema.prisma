// Prisma schema for the Realtime POS / Inventory / Pre-order system.
//
// Mirrors `system_requirements_document.md` §7. Additions, all flagged in
// README.md and docs/adr/:
//   * stock_logs.reason          — §4.3 mandates an adjustment-reason enum that
//                                  §7's DDL forgot to declare.
//   * orders.pickup_expires_at   — §3 Phase 3 mandates a holding-time limit.
//   * shops + orders VAT columns — the SRS has no shop identity and no tax
//                                  concept at all; see ADR 0002.
//   * products.category_id FK     — SET NULL became RESTRICT, so the database
//                                  refuses to orphan products.
//
// Deliberately absent: time_logs.work_hours. It is a PostgreSQL STORED generated
// column, which Prisma cannot model, so it lives in the initial migration only
// and is read with $queryRaw.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- shop

/**
 * The shop this deployment belongs to.
 * The SRS is silent on shop identity — receipts, page titles and the tax rate
 * were hardcoded — so this is an addition on top of §7 (see ADR 0002).
 * Exactly one row is allowed, which the migration enforces with
 * `CHECK (id = 1)`. That is what makes double-initialisation impossible when two
 * requests race through the setup wizard: the second INSERT collides on the
 * primary key rather than winning a read-then-write check.
 */
model shops {
  id                            Int                @id @default(1)
  name                          String             @db.VarChar(150)
  legal_name                    String?            @db.VarChar(200)
  branch_label                  String?            @db.VarChar(100)
  tax_id                        String?            @db.VarChar(13)
  address                       String?
  phone                         String?            @db.VarChar(20)
  is_vat_registered             Boolean            @default(false)
  vat_rate                      Decimal            @default(7) @db.Decimal(5, 2)
  prices_include_vat            Boolean            @default(true)
  receipt_prefix                String             @default("RC") @db.VarChar(10)
  receipt_running_number        BigInt             @default(0)
  /**
   * The credit-note series, kept apart from the receipt series on purpose.
   * A shop's invoice series and its credit-note series are two documents that an
   * auditor reads against each other; interleaving them would make "how many
   * invoices did you issue" a question about a shared counter instead of about a
   * document type. Same gapless rule, same serialisation on this row.
   */
  credit_note_prefix            String             @default("CN") @db.VarChar(10)
  credit_note_running_number    BigInt             @default(0)
  /**
   * The day's call-number counter (ADR 0017) — a short number a customer can hear
   * across a counter, which is a different job from the receipt series above: it
   * restarts every Bangkok day and it is not a tax document.
   * `queue_running_day` is what "the day" means, and comparing it inside the same
   * statement that bumps the counter is what makes a midnight sale take 1 rather
   * than 847. It is a `Date` rather than a timestamp because the day is the whole
   * comparison — no time of day is ever read from it.
   */
  queue_running_number          Int                @default(0)
  queue_running_day             DateTime?          @db.Date
  receipt_footer                String?
  logo_url                      String?
  /**
   * Where the shop receives PromptPay transfers. Null means the till cannot
   * issue a QR and asks the cashier to confirm the transfer by hand instead.
   */
  promptpay_id                  String?            @db.VarChar(20)
  promptpay_type                promptpay_id_type?
  /**
   * The discount a cashier may give without asking a supervisor. Past it the
   * till demands a PIN, so the limit is the shop's policy stated as a number
   * rather than as a habit nobody wrote down.
   */
  supervisor_discount_limit_thb Decimal            @default(50) @db.Decimal(10, 2)
  created_at                    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
}

// ----------------------------------------------------- offline number blocks

/**
 * A range of the shop's numbers lent to a device (ADR 0019).
 *
 * A browser cannot bump `receipt_running_number` inside the sale's transaction, so a
 * device that may lose its connection is handed a range in advance and issues from it
 * itself. This row is that loan: which series, which numbers, who it went to, and how
 * far it got.
 *
 * Four properties are deliberate, and three of them are the database's rather than a
 * convention's:
 * * `day` is set on the call-number series and null on the receipt series — a CHECK
 *   says so. Call numbers restart every Bangkok day; the tax series does not.
 * * **At most one open block per series (per day)** is a partial unique index, so two
 *   devices racing to borrow the same day's numbers cannot both win.
 * * `reported_at` and `cancelled_at` exclude each other, and a cancelled block may not
 *   have been used. A block with usage is *reported* (how far it got); a block nobody
 *   touched is *cancelled* (all of it comes back). Stating both in CHECKs is what stops
 *   a later screen from inventing a third state.
 * * `last_used_number` is advanced by every bill the device issues, whether it reached
 *   the server at the time or is replaying later — which is what makes the freeze in
 *   `allocateReceiptNumber` correct rather than merely cautious.
 */
model number_blocks {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  series           number_series
  day              DateTime?     @db.Date
  from_number      Int
  to_number        Int
  last_used_number Int?
  device_label     String        @db.VarChar(60)
  opened_by        String        @db.Uuid
  opened_at        DateTime      @default(now()) @db.Timestamptz(6)
  reported_at      DateTime?     @db.Timestamptz(6)
  cancelled_at     DateTime?     @db.Timestamptz(6)
  /**
   * Who closed it: the device reporting itself, or the admin resolving a loose end after
   * a tablet never came back. Two different acts with the same shape, and the one that
   * matters months later is the second — somebody said out loud that the numbers had
   * stopped there, and the series moved on that word.
   */
  closed_by        String?       @db.Uuid

  opener users  @relation("number_block_opener", fields: [opened_by], references: [id], onDelete: Restrict)
  closer users? @relation("number_block_closer", fields: [closed_by], references: [id], onDelete: Restrict)

  @@index([series, opened_at])
}

// ---------------------------------------------------------------- enums

/**
 * Which of the shop's numbered series a block was lent from (ADR 0019).
 * An enum rather than a string for the reason every other machine in this file is one,
 * plus a concrete one: the freeze compares against a literal series in the same
 * statement that allocates, and a mistyped series there would freeze nothing at all.
 */
enum number_series {
  /** The tax-invoice series: gapless, per year, serialised on the shop row. */
  receipt
  /** The call number: short, restarting every Bangkok day (ADR 0017). */
  queue
}

enum user_role {
  member
  employee
  admin
}

enum order_type {
  pos_walkin
  preorder
}

enum order_status {
  pending
  confirmed
  ready_for_pickup
  completed
  cancelled
  /**
   * A sale that was paid for and then reversed — always with a credit note.
   * Its own status rather than a flag on `completed`, because "was this bill
   * refunded" is the question every report, receipt lookup and refusal message
   * needs to answer, and the state machine is the one place that can answer it
   * for all of them at once: `completed → refunded` is the only way in, and
   * `refunded` is terminal, so a second refund is refused by `canTransition`
   * before any transaction is opened.
   */
  refunded
}

enum payment_method {
  cash
  promptpay
  points
  mixed
}

/**
 * Where a paid order's goods are (ADR 0018).
 * Beside `order_status`, never inside it: `completed` is what every report counts,
 * and a sale's money is finished the moment it is paid, whatever the drink is
 * doing. Null means "no goods to wait for" — a pre-order, whose handover is the
 * moment it is paid for, and every bill that predates this machine.
 * An enum rather than a string, for the reason `audit_action` is one: a state
 * machine whose vocabulary can drift silently is not a state machine.
 */
enum fulfilment_state {
  preparing
  ready
  collected
}

enum stock_movement_type {
  manual_adjust
  pos_sale
  preorder_reserve
  preorder_cancel
  restock
  /**
   * Goods coming back onto the shelf because the sale was reversed.
   * Distinct from `restock` (stock arriving from a supplier) and from
   * `preorder_cancel` (a reservation that never left), because a stock report
   * that cannot tell a return from a delivery cannot tell a bad week from a
   * generous one.
   */
  pos_refund
}

/**
 * Which way the money in a `payments` row went.
 *
 * A column rather than a negative `amount`, because
 * `chk_payments_amount_positive` is worth keeping: an amount is a magnitude, and
 * a table where "how much" and "which way" are the same field is a table where
 * every sum needs remembering to be written signed. Here, one column says the
 * direction once and every existing aggregate either nets it deliberately or
 * filters on it deliberately — and neither can happen by accident.
 */
enum payment_direction {
  sale
  refund
}

enum stock_adjustment_reason {
  REASON_RESTOCK
  REASON_DAMAGED
  REASON_EXPIRED
  REASON_CORRECTION
  REASON_IMPORT
}

enum shift_status {
  open
  closed
}

/**
 * What a supervisor approved, or what the system recorded on their behalf.
 * An enum rather than a free-text code, so "which voids happened last month" is
 * a question the database can answer rather than a grep through strings. Adding
 * a gated action therefore costs a migration — deliberately, because an audit
 * trail whose vocabulary can drift silently is not an audit trail.
 */
/**
 * Which kind of PromptPay account the shop receives on.
 * The three cases carry different identifiers and, critically, different rates of
 * identifier length in the payload — a mobile is written as `0066` plus nine
 * digits, a national id as thirteen digits, an e-wallet as fifteen. Storing the
 * kind rather than inferring it from the shape of the value keeps a shop with a
 * mobile number and a shop with a tax id from being told apart by guesswork.
 */
enum promptpay_id_type {
  mobile
  national_id
  ewallet
}

/**
 * How a payment intent ended.
 * `consumed` is separate from `paid` on purpose: `paid` says the money arrived,
 * `consumed` says the till then closed a bill with it. Without the second state a
 * confirmation arriving twice, or after the cashier had already given up and
 * taken cash, would close two sales for one transfer.
 */
enum payment_intent_status {
  pending
  paid
  expired
  cancelled
  consumed
}

/**
 * What became of a transfer the bank told us about.
 *
 * `unmatched` is not an error state and not a queue to be drained — it is money
 * in the shop's account that this system cannot attribute, which is a fact the
 * owner has to be able to see. `dismissed` is a person having looked at it and
 * said it is not ours.
 */
enum inbound_payment_status {
  matched
  unmatched
  dismissed
}

/**
 * Why a notification could not be attributed.
 * Mirrors `InboundRefusalReason` in `src/lib/inbound-match.ts`, which is where the
 * decision is made; a value here is a sentence somebody has to act on, so the set
 * stays small and closed.
 */
enum inbound_refusal_reason {
  amount_unreadable
  no_amount_match
  no_reference
  ambiguous
  not_payable
}

enum audit_action {
  void_order
  over_discount
  drawer_open
  manual_payment_confirm
  /**
   * Money going back to a customer, with a credit note behind it.
   * Its own action rather than a second `void_order`: a void stops a sale that
   * was never paid, a refund reverses one that was, and an owner scanning the
   * trail for "where did the cash go" needs to be able to tell them apart.
   */
  refund_order
  /**
   * A person said a transfer in the bank account is not a sale of ours.
   * The only human decision in the inbound path, and therefore the only part of
   * it that is audited: a machine match has the bank's own notification behind
   * it, while a dismissal has nothing but somebody's word — which is exactly the
   * kind of claim a trail exists to keep.
   */
  inbound_transfer_dismissed
  pin_set
  pin_reset
  pin_locked
  display_paired
  display_revoked
  /**
   * A caller spent every attempt a rate-limited door allowed them.
   * Recorded once per burst rather than once per request: the event an owner
   * needs is "somebody started guessing", and a row per refusal would be a trail
   * the attacker writes to at volume. `pin_locked` is the same idea one layer
   * down, where five wrong PINs for one admin is the trip.
   */
  rate_limited
  /**
   * A customer account was created at the counter, with a password in it.
   * Audited because a member can reserve stock without paying, which makes an
   * account worth inventing — and because "who added this customer" is the
   * question a shop asks when a name it does not recognise turns up with twelve
   * pending pre-orders.
   */
  member_created
  /**
   * A customer account had something changed about how it signs in, or whether it
   * can: the phone number, the email, the password, or the account being closed.
   * Not a rename — the trail is for what a later reader needs to find, and every
   * corrected spelling is not one of those.
   */
  member_updated
  /**
   * A bill that was closed with no connection reached the shop, and how (ADR 0019).
   * Its own action rather than a note on the sale, because the fact an owner needs is
   * "this bill was recorded offline and synced at 08:12" — the printed slip and the
   * record can differ for reasons nobody remembers a week later, and this row is what
   * makes the difference an explanation instead of a rumour.
   */
  offline_sale_synced
}

// ---------------------------------------------------------------- users

model users {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String?   @unique @db.VarChar(255)
  // ---------------------------------------------------- a Google door (ADR 0020)
  // The subject id from a verified Google id token, so a returning customer who
  // signed in with Google is recognised as the same row. Unique, so one Google
  // account cannot attach to two customers. Null is the normal state: the counter
  // flow (ADR 0011) never sets it, and the phone remains the identity.
  google_subject      String?   @unique @db.VarChar(255)
  phone               String    @unique @db.VarChar(20)
  password_hash       String    @db.VarChar(255)
  full_name           String    @db.VarChar(100)
  role                user_role @default(member)
  points_balance      Int       @default(0)
  is_active           Boolean   @default(true)
  // ---------------------------------------------------------- supervisor PIN
  // A 4-digit PIN that authorises the actions a cashier may not take alone
  // (void a bill, discount past the shop's own limit, open the drawer, confirm a
  // transfer by hand). It is a *second* credential, separate from the password:
  // the person who approves is usually not the person signed in at the till, and
  // typing a full password in front of a customer is not a realistic ask.
  //
  // Null means "this account holds no PIN", which is the normal state for
  // cashiers and for members. Only administrators may set one.
  pin_hash            String?   @db.VarChar(255)
  pin_failed_attempts Int       @default(0)
  pin_locked_until    DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  orders_as_customer  orders[]             @relation("order_customer")
  orders_as_cashier   orders[]             @relation("order_cashier")
  stock_logs          stock_logs[]
  schedule_shifts     work_schedules[]     @relation("schedule_employee")
  schedules_authored  work_schedules[]     @relation("schedule_author")
  time_logs           time_logs[]
  shifts_opened       cash_shifts[]        @relation("shift_opener")
  shifts_closed       cash_shifts[]        @relation("shift_closer")
  point_transactions  point_transactions[]
  audit_logs_acted    audit_logs[]         @relation("audit_actor")
  audit_logs_approved audit_logs[]         @relation("audit_authorizer")
  payment_intents     payment_intents[]    @relation("intent_cashier")
  intents_confirmed   payment_intents[]    @relation("intent_confirmer")
  display_devices     display_devices[]
  credit_notes_issued credit_notes[]       @relation("credit_note_issuer")
  credit_notes_approved credit_notes[]     @relation("credit_note_approver")
  inbound_dismissals  inbound_payments[]   @relation("inbound_dismisser")
  number_blocks       number_blocks[]      @relation("number_block_opener")
  blocks_closed       number_blocks[]      @relation("number_block_closer")
  // ------------------------------------------------ consignment (ADR 0023)
  consigned_products  products[]           @relation("consigned_products")
  consignor_payables  consignor_payables[] @relation("payable_consignor")
}

// ---------------------------------------------------------------- catalog

model categories {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(100)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  products   products[]
}

model products {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id  Int?
  barcode      String?  @unique @db.VarChar(64)
  name         String   @db.VarChar(150)
  description  String?
  cost_price   Decimal  @default(0) @db.Decimal(10, 2)
  sale_price   Decimal  @default(0) @db.Decimal(10, 2)
  stock_qty    Int      @default(0)
  reserved_qty Int      @default(0)
  /**
   * How much of this product the till may **not** sell while it is offline
   * (ADR 0019, the weakened promise).
   *
   * Online, "never oversell" is one conditional `UPDATE` (`inventory.ts`). Offline it
   * cannot be, because the tally is a snapshot of what the shelf held when the device
   * last synced. So a shop sets a reserve per product and the device stops selling it
   * once `snapshot − safety − sold_offline` reaches zero. Zero means no reserve, which
   * is the honest default: a reserve nobody asked for is an item the shop cannot sell
   * for a reason it never chose. Read only into the device's catalogue snapshot; the
   * server's own oversell guard does not consult it, because the reserve is a device
   * rule and the online promise is unchanged.
   */
  offline_safety_qty Int      @default(0)
  image_url          String?
  is_active          Boolean  @default(true)
  // ------------------------------------------------------- consignment (ADR 0023)
  // Goods the shop sells but does not own. A null `consignor_user_id` is the normal
  // case: the product is the shop's own stock. When it is set, the product belongs
  // to exactly one member and `consignor_share_percent` is the agreed share of the
  // net (excluding VAT) the shop owes on each sale (ADR 0023 §2, §4). The two move
  // together — a consignment with no percent, or a percent with no consignor, is a
  // state the migration refuses in the database rather than in every code path.
  consignor_user_id       String? @db.Uuid
  consignor_share_percent Int?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // Restrict rather than SetNull: deleting a category that still has products
  // would silently orphan them, and the database now refuses it rather than
  // relying on the API to remember to check first.
  category    categories?   @relation(fields: [category_id], references: [id], onDelete: Restrict)
  stock_logs  stock_logs[]
  order_items order_items[]
  // Restrict for the same reason as the category: deleting the member who consigned
  // goods would orphan the shop's liability to them, which is money, not a label.
  consignor          users?                @relation("consigned_products", fields: [consignor_user_id], references: [id], onDelete: Restrict)
  consignor_payables consignor_payables[]

  @@index([category_id])
  @@index([is_active])
  @@index([consignor_user_id])
}

model stock_logs {
  id            BigInt                   @id @default(autoincrement())
  product_id    String                   @db.Uuid
  changed_by    String                   @db.Uuid
  movement_type stock_movement_type
  reason        stock_adjustment_reason?
  qty_changed   Int
  balance_after Int
  note          String?
  created_at    DateTime                 @default(now()) @db.Timestamptz(6)

  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user    users    @relation(fields: [changed_by], references: [id])

  @@index([product_id, created_at])
  @@index([created_at])
}

// ---------------------------------------------------------------- staffing

model work_schedules {
  id          Int      @id @default(autoincrement())
  employee_id String   @db.Uuid
  shift_date  DateTime @db.Date
  start_time  DateTime @db.Time(6)
  end_time    DateTime @db.Time(6)
  note        String?
  created_by  String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  employee users @relation("schedule_employee", fields: [employee_id], references: [id], onDelete: Cascade)
  author   users @relation("schedule_author", fields: [created_by], references: [id])

  @@unique([employee_id, shift_date])
  @@index([shift_date])
}

// work_hours is a STORED generated column added by the initial migration.
model time_logs {
  id          Int       @id @default(autoincrement())
  employee_id String    @db.Uuid
  check_in    DateTime  @default(now()) @db.Timestamptz(6)
  check_out   DateTime? @db.Timestamptz(6)
  note        String?

  employee users @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id, check_in])
}

model cash_shifts {
  id            Int          @id @default(autoincrement())
  opened_by     String       @db.Uuid
  closed_by     String?      @db.Uuid
  opened_at     DateTime     @default(now()) @db.Timestamptz(6)
  closed_at     DateTime?    @db.Timestamptz(6)
  initial_cash  Decimal      @default(0) @db.Decimal(10, 2)
  expected_cash Decimal?     @db.Decimal(10, 2)
  actual_cash   Decimal?     @db.Decimal(10, 2)
  status        shift_status @default(open)

  opener          users             @relation("shift_opener", fields: [opened_by], references: [id])
  closer          users?            @relation("shift_closer", fields: [closed_by], references: [id])
  payments        payments[]
  audit_logs      audit_logs[]
  payment_intents payment_intents[]
  credit_notes    credit_notes[]

  @@index([status])
}

// ---------------------------------------------------------------- audit

/**
 * The audit trail (SRS §4.3's spirit, extended to money and authority).
 * Two people can be named on one row, and the distinction is the whole point:
 * `actor_user_id` is who was standing at the till, `authorized_by_user_id` is
 * whose PIN approved it. "Who let this through" and "who was at the keyboard"
 * are different questions, and an audit trail that can only answer one of them
 * is the kind that gets ignored during an investigation.
 * Rows are never updated or deleted — a trigger in the migration refuses both,
 * and the foreign keys are RESTRICT so that nulling an actor is refused too. So
 * `detail` is the only place a later reader can find the context: the amount,
 * the previous value, the reason.
 */
model audit_logs {
  id                    BigInt       @id @default(autoincrement())
  action                audit_action
  actor_user_id         String?      @db.Uuid
  authorized_by_user_id String?      @db.Uuid
  target_type           String?      @db.VarChar(40)
  target_id             String?      @db.VarChar(60)
  shift_id              Int?
  detail                Json?
  created_at            DateTime     @default(now()) @db.Timestamptz(6)

  actor         users?       @relation("audit_actor", fields: [actor_user_id], references: [id], onDelete: Restrict)
  authorized_by users?       @relation("audit_authorizer", fields: [authorized_by_user_id], references: [id], onDelete: Restrict)
  shift         cash_shifts? @relation(fields: [shift_id], references: [id], onDelete: Restrict)

  @@index([action, created_at])
  @@index([actor_user_id, created_at])
  @@index([created_at])
}

// ------------------------------------------------------------ rate limiting

/**
 * One rate limiter bucket, shared by every process (ADR 0012).
 *
 * The limiter's memory used to be a `Map` in the process, which was defensible for
 * one listener and became two limiters the moment there were two — each half as
 * strict as the configuration says, and both forgotten by a restart. A row per
 * bucket is the smallest thing that fixes both, and this deployment already has the
 * database.
 *
 * The key is the same string the policy layer composes (`policy|address` or
 * `policy|address|scope`), so the row a caller is counted in is the row the pure
 * decision reasons about. `tokens` is fractional on purpose: refill is continuous,
 * so a bucket genuinely holds 3.4 attempts. `updated_at` is written with the
 * *database's* clock, which is the only clock several processes agree on.
 *
 * No index beyond the primary key: the table is one row per caller who has been
 * limited lately, and the sweep deletes by `updated_at` on a table small enough to
 * scan. The column is wider than `MAX_BUCKET_KEY_LENGTH` so that cap can be raised
 * without a migration.
 */
model rate_limit_buckets {
  bucket_key String   @id @db.VarChar(255)
  tokens     Float
  updated_at DateTime @db.Timestamptz(6)
  refusing   Boolean
}

// ---------------------------------------------------------------- orders

///
/// One in-flight phone-ownership challenge (ADR 0020 §5).
///
/// Keyed by the phone itself: issuing a new code replaces the row rather than
/// stacking challenges, so there is exactly one live code per number and a test
/// cannot accidentally verify a code from a previous send. The code is stored
/// hashed — a six-digit secret has only a million values, and a plaintext column
/// would hand an attacker the whole space in one leak — with an expiry and an
/// attempt ceiling so exhausting it costs more than guessing it.
///
/// Deliberately not tied to a `users` row by a foreign key: an OTP proves the
/// caller holds a phone, whether or not that phone is already a customer. That is
/// what lets the same door serve a first signup and a returning link alike
/// (ticket 02).
model otp_challenges {
  phone       String    @id @db.VarChar(20)
  code_hash   String    @db.VarChar(255)
  attempts    Int       @default(0)
  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
}

model orders {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number      String       @unique @db.VarChar(30)
  order_type        order_type   @default(pos_walkin)
  status            order_status @default(pending)
  customer_id       String?      @db.Uuid
  cashier_id        String?      @db.Uuid
  pickup_pin        String?      @db.VarChar(6)
  pickup_expires_at DateTime?    @db.Timestamptz(6)
  subtotal_amount   Decimal      @default(0) @db.Decimal(10, 2)
  discount_amount   Decimal      @default(0) @db.Decimal(10, 2)
  // Tax facts are *snapshotted*, never recomputed from the shop's current
  // settings: if 7% ever becomes 8%, a reprint of a 2026 receipt must still
  // show 7%, and `vat_rate_used` is what makes that possible.
  final_amount      Decimal      @default(0) @db.Decimal(10, 2)
  net_amount        Decimal      @default(0) @db.Decimal(10, 2)
  vat_amount        Decimal      @default(0) @db.Decimal(10, 2)
  vat_rate_used     Decimal?     @db.Decimal(5, 2)
  is_vat_invoice    Boolean      @default(false)
  receipt_number    String?      @unique @db.VarChar(30)
  /**
   * The number the customer is called by (ADR 0017): 1, 2, 3 … within one Bangkok
   * day, on walk-in sales only. Null on a pre-order, whose handover already has
   * its own identifiers — the bill number and the 4-digit PIN — and whose goods
   * are in the customer's hands by the time its bill is closed, so a call number
   * would be a number nobody ever calls.
   * `queue_day` is stored beside it rather than derived from `created_at` so the
   * pair can carry a unique index: `created_at` is an instant, and the day the
   * customer heard is Bangkok's, so the two disagree for the seven hours after
   * local midnight.
   */
  queue_number      Int?
  queue_day         DateTime?    @db.Date
  /**
   * Where the goods are, for a walk-in sale (ADR 0018).
   * Set to `preparing` by `createPosSale` — the bill is paid and the drink is
   * being made — and advanced by the bar tapping a ticket. `ready_at`, which a
   * pre-order already uses for the same fact, is the instant this reaches `ready`.
   */
  fulfilment        fulfilment_state?
  points_earned     Int          @default(0)
  points_redeemed   Int          @default(0)
  cancel_reason     String?
  /**
   * The device's own identity for a bill it closed with no connection (ADR 0019).
   *
   * A UUID the till generated, unique here — which is what makes the replay idempotent:
   * a retry after a timeout, or the same batch sent twice, writes one order because the
   * second insert is refused by this index. Null on every bill the server witnessed,
   * so `client_ref IS NOT NULL` is also the answer to "was this recorded offline".
   */
  client_ref        String?      @unique
  /**
   * The instant the sale happened for the books — the day every day-bucketed read
   * files it under, and the reason `created_at` is no longer asked (ADR 0019
   * decision 4; the rule is `src/lib/sale-instant.ts`).
   *
   * For an ordinary sale this is the server's now, the same instant `completed_at`
   * gets. For a replayed offline bill it is the **device's** instant, which is why the
   * two columns exist separately: a walk-in sale completed at 21:00 and synced at 08:12
   * is yesterday's takings, and `created_at`/`completed_at` would file it today.
   *
   * A pre-order that is still pending carries the creation instant here and nothing reads
   * it — every day bucket also filters on a terminal status, because a sale that has not
   * happened yet has no sale instant. `completeOrder` sets it at handover, which is when
   * the goods and the money actually moved.
   */
  sold_at           DateTime     @default(now()) @db.Timestamptz(6)
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  confirmed_at      DateTime?    @db.Timestamptz(6)
  ready_at          DateTime?    @db.Timestamptz(6)
  completed_at      DateTime?    @db.Timestamptz(6)
  cancelled_at      DateTime?    @db.Timestamptz(6)

  customer           users?               @relation("order_customer", fields: [customer_id], references: [id], onDelete: SetNull)
  cashier            users?               @relation("order_cashier", fields: [cashier_id], references: [id], onDelete: SetNull)
  items              order_items[]
  payments           payments[]
  point_transactions point_transactions[]
  payment_intents    payment_intents[]
  /**
   * Every credit note issued against this sale, in order.
   * A list rather than a single document: a bill can be refunded in pieces, and
   * "how much of this came back" is the sum of these rather than a column that can
   * drift away from them.
   */
  credit_notes       credit_notes[]  @relation("credit_notes_for_order")
  notifications      notifications[]
  consignor_payables consignor_payables[]

  @@index([status])
  @@index([created_at])
  /**
   * The day-bucketed reads' index. `created_at` keeps its own for the orders that have
   * no sale instant yet (a pending pre-order, the expiry sweeper), and this one exists
   * because a report over `sold_at` must not fall back to a sequential scan the month
   * the shop has fifty thousand bills.
   */
  @@index([sold_at])
  @@index([order_type, status])
  /**
   * One bill per number per day, stated where it cannot be forgotten. The
   * allocation already serialises on the shop row; this is the guarantee behind
   * that serialisation, because two bills sharing a number means calling one
   * customer to another's order — a failure that looks like a mistake by the
   * staff rather than like a bug. Nulls are distinct in PostgreSQL, so the
   * pre-orders that carry no number do not collide here.
   */
  @@unique([queue_day, queue_number])
  /**
   * The board's query: today's bills whose goods are not handed over yet. A plain
   * index rather than a partial one — Prisma cannot express `WHERE fulfilment IS
   * NOT NULL`, and the column is null for every pre-order, so the index is small
   * for what it is worth having on the busiest table in the shop.
   */
  @@index([fulfilment])
}

model order_items {
  id          BigInt  @id @default(autoincrement())
  order_id    String  @db.Uuid
  product_id  String  @db.Uuid
  unit_price  Decimal @db.Decimal(10, 2)
  unit_cost   Decimal @db.Decimal(10, 2)
  quantity    Int
  total_price Decimal @db.Decimal(10, 2)

  order   orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product products @relation(fields: [product_id], references: [id])
  /** The credit-note lines that took this one back, wholly or in part. */
  refunded_on credit_note_items[]
  /** The consignor shares this line's sale and any refund of it produced. */
  consignor_payables consignor_payables[]

  @@index([order_id])
  @@index([product_id])
}

model payments {
  id              Int               @id @default(autoincrement())
  order_id        String            @db.Uuid
  shift_id        Int?
  method          payment_method
  /** Always positive; `direction` carries the sign. */
  amount          Decimal           @db.Decimal(10, 2)
  direction       payment_direction @default(sale)
  /**
   * The credit note this leg pays out, for a refund leg — and null for a sale.
   * Enforced by the migration as `(direction = 'refund') = (credit_note_id IS
   * NOT NULL)`, so money can never leave without a document behind it and a sale
   * can never claim one.
   */
  credit_note_id  String?           @db.Uuid
  received_amount Decimal?          @db.Decimal(10, 2)
  change_amount   Decimal?          @db.Decimal(10, 2)
  transaction_ref String?           @db.VarChar(100)
  paid_at         DateTime          @default(now()) @db.Timestamptz(6)

  order       orders        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  shift       cash_shifts?  @relation(fields: [shift_id], references: [id], onDelete: SetNull)
  credit_note credit_notes? @relation(fields: [credit_note_id], references: [id], onDelete: Restrict)

  @@index([order_id])
  @@index([shift_id])
  @@index([paid_at])
  @@index([direction])
  @@index([credit_note_id])
}

// ------------------------------------------------------------ credit notes

/**
 * The document that reverses a paid sale — a full-amount credit note.
 *
 * Its own table rather than a flag on `orders`, because it is a *document*: it
 * has its own number from its own series, its own tax figures as issued, its own
 * reason, and two people named on it. A sale's total is a fact about the sale;
 * a credit note's total is a fact about a piece of paper that was handed to a
 * customer, and the two must be able to disagree later — which is exactly what
 * a partial refund would require, and why the figures are copied here rather
 * than read back through the order.
 *
 * `order_id` is UNIQUE. That is the double-refund guard that survives everything
 * else: `canTransition` stops the API path, and this index stops a race, a
 * retried request, and a future code path that forgets to ask.
 */
model credit_notes {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /** `CN-2026-000001`, from the shop's own gapless series. */
  document_number       String         @unique @db.VarChar(30)
  /** The sale being reversed. One receipt may carry several notes. */
  order_id              String         @db.Uuid
  /**
   * 1-based, within one sale.
   * A bill refunded in three visits has three notes, and "which one is this" is a
   * question an owner asks when the notes are read against the invoice.
   */
  sequence              Int            @default(1)
  /**
   * The drawer the money came out of, or null when it did not come out of one.
   * A refund paid by hand from the shop's banking app touches no drawer, and
   * recording a drawer it never left would invent a shortage at close.
   */
  shift_id              Int?
  reason                String
  refund_method         payment_method
  /**
   * The reversed tax facts, snapshotted at issue.
   * Copied from the sale rather than joined to it, so the document reprints
   * identically forever — and so a later partial refund, which would carry
   * *different* figures, is not a schema change.
   */
  /**
   * What this note's lines were charged, before the discount it accounts for.
   * A full reversal copies the sale's subtotal; a partial one is the pro-rata share
   * of the lines coming back. Stored rather than summed from the items so that the
   * database can check the document reconciles (`chk_credit_notes_lines_reconcile`).
   */
  gross_amount          Decimal        @default(0) @db.Decimal(10, 2)
  /**
   * This note's share of the order-level discount.
   * Every note but the last rounds its share; the note that empties the sale takes
   * the remainder, which is what makes the notes foot to the invoice exactly.
   */
  discount_amount       Decimal        @default(0) @db.Decimal(10, 2)
  final_amount          Decimal        @db.Decimal(10, 2)
  net_amount            Decimal        @db.Decimal(10, 2)
  vat_amount            Decimal        @db.Decimal(10, 2)
  vat_rate_used         Decimal?       @db.Decimal(5, 2)
  /**
   * What happened to the customer's points, recorded on the document.
   * `applyPointChange` refuses to drive a balance negative, and a customer who
   * has already spent their points must not be able to block their own refund —
   * so the clawback is clamped and the shortfall is stated here instead of
   * vanishing.
   */
  points_clawed_back    Int            @default(0)
  points_forgiven       Int            @default(0)
  created_by            String         @db.Uuid
  authorized_by_user_id String?        @db.Uuid
  created_at            DateTime       @default(now()) @db.Timestamptz(6)

  order         orders       @relation("credit_notes_for_order", fields: [order_id], references: [id], onDelete: Restrict)
  shift         cash_shifts? @relation(fields: [shift_id], references: [id], onDelete: Restrict)
  issuer        users        @relation("credit_note_issuer", fields: [created_by], references: [id], onDelete: Restrict)
  approver      users?       @relation("credit_note_approver", fields: [authorized_by_user_id], references: [id], onDelete: Restrict)
  /** The money legs of this document. At least one for any way of paying out. */
  payments      payments[]
  /**
   * The lines this note takes back, with their quantities.
   * This is what makes a partial refund a document rather than an adjustment, and
   * what a later refund reads to know how much of each line is still refundable.
   */
  items         credit_note_items[]

  @@unique([order_id, sequence])
  @@index([shift_id])
  @@index([created_at])
}

/**
 * One line of a credit note, and how much of it went back.
 * Quantity lives here rather than on the order line because a line can be returned
 * in more than one visit: three units sold, one back on Monday and two on Friday.
 */
model credit_note_items {
  id             BigInt  @id @default(autoincrement())
  credit_note_id String  @db.Uuid
  order_item_id  BigInt
  quantity       Int
  unit_price     Decimal @db.Decimal(10, 2)
  /** `unit_price × quantity`, to the satang — checked by the database. */
  line_total     Decimal @db.Decimal(10, 2)

  credit_note credit_notes @relation(fields: [credit_note_id], references: [id], onDelete: Cascade)
  order_item  order_items  @relation(fields: [order_item_id], references: [id], onDelete: Restrict)

  @@unique([credit_note_id, order_item_id])
  @@index([order_item_id])
}

// ---------------------------------------------------------------- payments

/**
 * A PromptPay QR issued for one amount, and what became of it.
 * The till asks for one of these before the sale exists, which is why it carries
 * its own `amount`, `shift_id` and `cashier_id` rather than pointing at an order:
 * the customer is scanning while the cashier still has a basket open. `order_id`
 * is filled in when the bill is finally closed with this intent, so the two
 * records end up joined, and the intent is what proves the QR was for this sale.
 * `status` is a small state machine, and each transition is deliberate:
 * pending  → paid       a confirmation arrived — a webhook, or a PIN holder
 * pending  → expired    nobody paid inside the window
 * pending  → cancelled  the cashier gave up and took cash instead
 * paid     → consumed   the sale was settled against it, exactly once
 * `consumed` is not bookkeeping: it is what makes a duplicate confirmation
 * harmless. A bank bridge that fires twice, or fires after the cashier has
 * already taken notes, must not be able to close two bills for one transfer.
 */
model payment_intents {
  id                   BigInt                @id @default(autoincrement())
  /**
   * The short code on the QR's reference field, and how a webhook names a bill.
   */
  ref                  String                @unique @db.VarChar(12)
  shift_id             Int
  cashier_id           String                @db.Uuid
  order_id             String?               @db.Uuid
  amount               Decimal               @db.Decimal(10, 2)
  /**
   * The EMVCo payload itself, kept so a disputed QR can be reproduced.
   */
  qr_payload           String
  status               payment_intent_status @default(pending)
  expires_at           DateTime              @db.Timestamptz(6)
  paid_at              DateTime?             @db.Timestamptz(6)
  consumed_at          DateTime?             @db.Timestamptz(6)
  /**
   * Set only when a person confirmed it; a webhook leaves this null.
   */
  confirmed_by_user_id String?               @db.Uuid
  created_at           DateTime              @default(now()) @db.Timestamptz(6)

  shift        cash_shifts @relation(fields: [shift_id], references: [id], onDelete: Restrict)
  cashier      users       @relation("intent_cashier", fields: [cashier_id], references: [id], onDelete: Restrict)
  confirmed_by users?      @relation("intent_confirmer", fields: [confirmed_by_user_id], references: [id], onDelete: SetNull)
  order        orders?     @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@index([status, expires_at])
  @@index([order_id])

  /**
   * Transfers the bank reported against this QR. The relation is what makes
   * `inbound_payments.intent_ref` a fact rather than a string that used to be a
   * reference: a row claiming to have closed a bill has to name a real one.
   */
  inbound_transfers inbound_payments[] @relation("inbound_intent")
}

// ---------------------------------------------------- inbound bank transfers

/**
 * Money the bank said arrived, whether or not we can say which bill it paid.
 *
 * This table exists because the alternative is silence. A notification that names
 * no QR, or an amount nobody is waiting for, is still money in the shop's account:
 * dropping it would leave the shop with a bank balance it cannot explain, and
 * guessing at a bill would put somebody else's payment on a customer's receipt.
 * So it is recorded, with the reason it was refused, and shown to an owner.
 *
 * Two columns carry the whole design:
 *
 *   * `external_id` is the bank's own identifier for the message (a mail's
 *     Message-ID), unique per `source`. A bridge that retries must not record the
 *     same transfer twice, and the database is what guarantees it rather than the
 *     bridge's bookkeeping.
 *   * `received_at` is the *bank's* instant. Payability is measured against it,
 *     never against the moment the bridge got round to posting, so a notification
 *     delayed in a mailbox is still judged by when the money actually moved.
 */
model inbound_payments {
  id                    BigInt                 @id @default(autoincrement())
  /** Null only when the notification held no readable amount — see the CHECK. */
  amount                Decimal?               @db.Decimal(10, 2)
  received_at           DateTime               @db.Timestamptz(6)
  /** Who told us: `bank-bridge`, `webhook`, or whatever a shop names theirs. */
  source                String                 @db.VarChar(40)
  external_id           String?                @db.VarChar(200)
  /** The notification itself, kept so a disputed payment can be re-read. */
  raw_text              String
  status                inbound_payment_status @default(unmatched)
  refusal_reason        inbound_refusal_reason?
  /**
   * The QR this closed. Null for anything a person still has to deal with.
   */
  intent_ref            String?                @db.VarChar(12)
  dismissed_reason      String?
  dismissed_by_user_id  String?                @db.Uuid
  dismissed_at          DateTime?              @db.Timestamptz(6)
  created_at            DateTime               @default(now()) @db.Timestamptz(6)

  intent       payment_intents? @relation("inbound_intent", fields: [intent_ref], references: [ref], onDelete: Restrict)
  dismissed_by users?           @relation("inbound_dismisser", fields: [dismissed_by_user_id], references: [id], onDelete: Restrict)

  @@unique([source, external_id])
  @@index([status, received_at])
}

// ------------------------------------------------- notification outbox

/**
 * Which transport a queued message goes out on.
 * Two, and both of them are a `fetch` to a URL the shop already has. This system
 * owns no SMS account and no payment provider for the same reason it reads the
 * shop's own bank mail: a subscription is a thing a small shop has to keep
 * paying, and every one of them is a company that can go away.
 */
enum notification_channel {
  /** LINE Messaging API push. Addresses a LINE user id or group id, not a phone. */
  line
  /** A JSON POST to the shop's own gateway — an SMS provider, or a script. */
  webhook
}

/**
 * What became of one queued message.
 * `abandoned` is not a failure of the message, it is a failure of the *shop's
 * configuration*: six attempts over eight hours all hit the same wrong URL. It is
 * its own state rather than staying `pending` so that a wrong gateway shows up as
 * a growing pile of rows with a reason attached, instead of a worker that grinds
 * on them forever.
 */
enum notification_status {
  pending
  sent
  abandoned
}

/**
 * A message that should go out, written in the same transaction that made it true.
 *
 * The order matters and is the whole point of the table. `markOrderReady` commits
 * the order and this row together, so a process that dies between the commit and
 * the send loses nothing: the fact is on disk before anything tries to deliver it,
 * and the worker picks it up on its next pass. Announcing after the fact with a
 * `fetch` in the request path — which is what most systems do first — turns a
 * dropped connection into a customer who is never told their parcel is waiting.
 *
 * Three details carry the design:
 *
 *   * `UNIQUE (kind, order_id)` is the dedupe. "Your order is ready" is a fact
 *     about one order, so a route that is retried, a worker that runs twice, and a
 *     double click all produce one message.
 *   * `attempts` and `next_attempt_at` are the retry schedule, and the schedule
 *     itself is pure (`src/lib/notify-retry.ts`) — a worker that claims a row moves
 *     `next_attempt_at` forward *before* it tries, so a worker killed mid-send
 *     leaves a row that comes back rather than one stuck in flight forever.
 *   * `body` is the message as it will be sent, not a template name. Rendered
 *     once, when the fact was fresh, so an edit to the wording tomorrow cannot
 *     rewrite what a customer was told yesterday.
 */
model notifications {
  id              BigInt              @id @default(autoincrement())
  kind            String              @db.VarChar(40)
  channel         notification_channel
  /** A phone number for a gateway, a group id for LINE. */
  recipient       String              @db.VarChar(120)
  body            String
  status          notification_status @default(pending)
  attempts        Int                 @default(0)
  next_attempt_at DateTime            @default(now()) @db.Timestamptz(6)
  last_error      String?
  /**
   * The order this is about, which is also what makes it unique.
   * Null would mean a message about nothing in particular; nothing sends one yet,
   * and the unique index treats nulls as distinct, so a future shop-wide
   * announcement is not blocked by this constraint.
   */
  order_id        String?             @db.Uuid
  created_at      DateTime            @default(now()) @db.Timestamptz(6)
  sent_at         DateTime?           @db.Timestamptz(6)

  order orders? @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@unique([kind, order_id])
  /** The worker's query: everything due, oldest first. */
  @@index([status, next_attempt_at])
}

// ---------------------------------------------------------------- display

/**
 * A customer-facing screen that has been paired with this till.
 * The screen holds no account and no data of its own — it is a browser on the
 * same shop, and the only thing it may do is receive what the till chooses to
 * send it. So this row is not a user: it is a revocable grant, addressed by a
 * token stored in the screen's own `localStorage`.
 * Only the hash of that token is kept, for the same reason password hashes are:
 * a database dump must not hand somebody the ability to join a shop's realtime
 * channel and watch its takings.
 * Pairing is a two-step handshake — an admin displays a six-digit code, the
 * screen posts it back, the screen receives the token — which is what keeps the
 * grant deliberate. A code that expires in minutes and can be revoked is the
 * smallest thing that is still safe on a shop floor.
 */
model display_devices {
  id                 BigInt    @id @default(autoincrement())
  label              String    @db.VarChar(60)
  token_hash         String    @unique @db.VarChar(255)
  /**
   * Present only between "add a screen" and the screen redeeming it.
   */
  pairing_code       String?   @unique @db.VarChar(6)
  pairing_expires_at DateTime? @db.Timestamptz(6)
  paired_by_user_id  String?   @db.Uuid
  last_seen_at       DateTime? @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)

  paired_by users? @relation(fields: [paired_by_user_id], references: [id], onDelete: SetNull)
}

/** What moved a consignor's balance (ADR 0023 §2, §5, §6). */
enum consignor_payable_kind {
  /** A sale of consigned goods credited the consignor their share. */
  sale
  /** A refund of a consigned sale clawed the share back. */
  refund
  /** A payout handed the consignor money, debiting the balance. */
  payout
}

/**
 * What the shop owes each consignor (ADR 0023 §2).
 *
 * An append-only ledger the way `point_transactions` is — a credit when consigned
 * goods sell, a debit when a refund claws the share back or a payout hands it over,
 * and the balance is the *sum* rather than a column that can drift away from the rows.
 * `amount_thb` is signed, so the arithmetic is one addition and the migration's CHECK
 * refuses a row whose sign disagrees with its kind (a sale that debits, a payout that
 * credits).
 *
 * The money path itself is untouched: the sale is the shop's own (its receipt, its
 * series, its VAT, ADR 0023 §3), and this ledger records only the debt that sale
 * created. That is what keeps the share from becoming a second inventory and a second
 * sales path.
 */
model consignor_payables {
  id                BigInt                 @id @default(autoincrement())
  consignor_user_id String                 @db.Uuid
  kind              consignor_payable_kind
  /** Signed: a sale credits, a refund and a payout debit. */
  amount_thb        Decimal                @db.Decimal(10, 2)
  /** The sale or refund this movement came from; null on a payout. */
  order_id          String?                @db.Uuid
  /** The line that sold, so a refund can name exactly what went back. */
  order_item_id     BigInt?
  product_id        String?                @db.Uuid
  description       String?                @db.VarChar(255)
  created_at        DateTime               @default(now()) @db.Timestamptz(6)

  // Restrict rather than cascade: this is the shop's liability to a real person, and
  // deleting them must not quietly erase what they are owed.
  consignor  users        @relation("payable_consignor", fields: [consignor_user_id], references: [id], onDelete: Restrict)
  order      orders?      @relation(fields: [order_id], references: [id], onDelete: SetNull)
  order_item order_items? @relation(fields: [order_item_id], references: [id], onDelete: SetNull)
  product    products?    @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([consignor_user_id, created_at])
  @@index([order_id])
}

model point_transactions {
  id            BigInt   @id @default(autoincrement())
  user_id       String   @db.Uuid
  order_id      String?  @db.Uuid
  points_change Int
  balance_after Int
  description   String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  user  users   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  order orders? @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at])
}
