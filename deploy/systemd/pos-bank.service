# Reads the shop's own bank-notification mailbox and posts what it finds
# (`npm run bank:bridge -- --interval 60`). This is what lets an incoming PromptPay
# transfer close its own bill with no payment provider and nobody watching a screen.
#
# Optional, and it must not be enabled before `.env` carries the bank's mailbox,
# BANK_AMOUNT_REGEX and PAYMENT_WEBHOOK_SECRET: without them the script refuses to
# start, which is correct behaviour and noisy on a timer. Test it against a saved
# notification first — `npm run bank:bridge -- --file ./notification.eml` — then
# enable this.
[Unit]
Description=POS bank notification bridge
Documentation=file:/opt/pos/docs/homelab-deploy.md
After=network-online.target pos.service
Wants=network-online.target pos.service
# Half an hour of retries, then it stops where a person can find it: `systemctl
# status pos-bank` and the journal show the same line as every other attempt, so the
# unit is left failed rather than flapping all night and burying the reason.
StartLimitIntervalSec=1800
StartLimitBurst=10

[Service]
Type=simple
User=pos
Group=pos
WorkingDirectory=/opt/pos
ExecStart=/usr/bin/env npm run bank:bridge -- --interval 60
Restart=on-failure
RestartSec=60
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
